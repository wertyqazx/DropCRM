digraph Activity {
 graph [rankdir=TB,bgcolor="white",pad=0.3,nodesep=0.35,ranksep=0.45,label="UC-S04 · Сохранить отправление" ,labelloc=t,fontname="Arial",fontsize=18];
 node [shape=box,style="rounded,filled",fillcolor="#F4F5F7",color="#CBD2D9",fontname="Arial",fontsize=12,margin="0.17,0.10"];
 edge [fontname="Arial",fontsize=10,color="#596774"];
 start [shape=circle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
 end [shape=doublecircle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
s0 [label="Открывает заказ в обработке Система предлагает\nдобавить отправление."];
s1 [label="Указывает службу, трек-номер и дату Система\nпроверяет обязательные сведения."];
s2 [label="Подтверждает отправку Система сохраняет\nотправление и событие; остаток и резерв\nизменяются по P-02."];
s3 [label="Дропшиппер открывает свой заказ Видит те же\nслужбу, номер и дату."];
start -> s0;
s0 -> s1;
g1 [shape=diamond,style=filled,fillcolor="#EEF2F6",label="Данные заполнены?"];
e1 [label="Оставить прежний статус. Исправить сведения"];
s1 -> g1;
g1 -> s2 [label="Да"];
g1 -> e1 [label="Нет"];
e1 -> s1;
s2 -> s3;
