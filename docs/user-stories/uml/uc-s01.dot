digraph Activity {
 graph [rankdir=TB,bgcolor="white",pad=0.3,nodesep=0.35,ranksep=0.45,label="UC-S01 · Опубликовать предложение" ,labelloc=t,fontname="Arial",fontsize=18];
 node [shape=box,style="rounded,filled",fillcolor="#F4F5F7",color="#CBD2D9",fontname="Arial",fontsize=12,margin="0.17,0.10"];
 edge [fontname="Arial",fontsize=10,color="#596774"];
 start [shape=circle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
 end [shape=doublecircle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
s0 [label="Открывает свой ассортимент Система показывает\nсобственные предложения."];
s1 [label="Выбирает создание Система открывает поля товара и\nусловий."];
s2 [label="Указывает название, категорию, цену, остаток и\nсрок обработки Система проверяет обязательные\nзначения."];
s3 [label="Подтверждает публикацию Система показывает\nпредложение и подтверждение; активное доступно в\nобщем каталоге."];
start -> s0;
s0 -> s1;
s1 -> s2;
g2 [shape=diamond,style=filled,fillcolor="#EEF2F6",label="Поля корректны?"];
e2 [label="Исправить данные предложения"];
s2 -> g2;
g2 -> s3 [label="Да"];
g2 -> e2 [label="Нет"];
e2 -> s2;
s3 -> end;
}
