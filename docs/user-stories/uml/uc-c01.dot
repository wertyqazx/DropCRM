 start [shape=circle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
 end [shape=doublecircle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
open [label="Выбрать роль и заполнить форму"];
valid [shape=diamond,label="Поля корректны?",fillcolor="#EEF2F6"]; role [shape=diamond,label="Роль",fillcolor="#EEF2F6"];
error [label="Показать ошибки, сохранить данные"];
d [label="Дропшиппер: создать аккаунт и перейти к подписке"];
