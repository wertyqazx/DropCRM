digraph Activity {
 graph [rankdir=TB,bgcolor="white",pad=0.3,nodesep=0.35,ranksep=0.45,label="UC-S03 · Подтвердить наличие и доставку" ,labelloc=t,fontname="Arial",fontsize=18];
 node [shape=box,style="rounded,filled",fillcolor="#F4F5F7",color="#CBD2D9",fontname="Arial",fontsize=12,margin="0.17,0.10"];
 edge [fontname="Arial",fontsize=10,color="#596774"];
 start [shape=circle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
 end [shape=doublecircle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
s0 [label="Открывает новый заказ Система показывает позиции,\nколичество и получателя."];
s1 [label="Проверяет наличие и возможность доставки Система\nпоказывает актуальные условия и необходимые\nуточнения."];
s2 [label="Указывает доставку и подтверждает Система\nфиксирует условия и резерв по P-02."];
s3 [label="Дропшиппер открывает тот же заказ Система\nпоказывает полный итог и возможность оплаты."];
start -> s0;
s0 -> s1;
g1 [shape=diamond,style=filled,fillcolor="#EEF2F6",label="Наличие и доставка\nподтверждены?"];
e1 [label="Отклонить с причиной. Оплату не открывать"];
s1 -> g1;
g1 -> s2 [label="Да"];
g1 -> e1 [label="Нет"];
e1 -> end;
s2 -> s3;
s3 -> end;
}
