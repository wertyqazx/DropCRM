digraph Activity {
 graph [rankdir=TB,bgcolor="white",pad=0.3,nodesep=0.35,ranksep=0.45,label="UC-D02 · Изменить наценку и активность" ,labelloc=t,fontname="Arial",fontsize=18];
 node [shape=box,style="rounded,filled",fillcolor="#F4F5F7",color="#CBD2D9",fontname="Arial",fontsize=12,margin="0.17,0.10"];
 edge [fontname="Arial",fontsize=10,color="#596774"];
 start [shape=circle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
 end [shape=doublecircle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
s0 [label="Открывает личный каталог Система показывает\nтекущую цену, наценку и активность."];
s1 [label="Выбирает изменение Система заполняет форму\nтекущими значениями."];
s2 [label="Меняет наценку или активность Система показывает\nновое состояние и цену без сохранения."];
s3 [label="Сохраняет Система обновляет ту же позицию и\nподтверждает результат."];
start -> s0;
s0 -> s1;
s1 -> s2;
g2 [shape=diamond,style=filled,fillcolor="#EEF2F6",label="Сохранить?"];
e2 [label="Оставить исходные значения"];
s2 -> g2;
g2 -> s3 [label="Да"];
g2 -> e2 [label="Отмена"];
e2 -> end;
s3 -> end;
}
