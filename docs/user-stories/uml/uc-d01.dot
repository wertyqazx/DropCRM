digraph Activity {
 graph [rankdir=TB,bgcolor="white",pad=0.3,nodesep=0.35,ranksep=0.45,label="UC-D01 · Найти предложение и добавить в каталог" ,labelloc=t,fontname="Arial",fontsize=18];
 node [shape=box,style="rounded,filled",fillcolor="#F4F5F7",color="#CBD2D9",fontname="Arial",fontsize=12,margin="0.17,0.10"];
 edge [fontname="Arial",fontsize=10,color="#596774"];
 start [shape=circle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
 end [shape=doublecircle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
s0 [label="Открывает общий каталог Система показывает\nпредложения с поставщиком, ценой и наличием."];
s1 [label="Задаёт поиск и фильтры Система показывает\nподходящий результат и число найденных\nпредложений."];
s2 [label="Открывает предложение Система показывает\nхарактеристики и условия поставщика."];
s3 [label="Выбирает добавление и наценку Система проверяет\nзначение и показывает цену продажи."];
s4 [label="Подтверждает добавление Система сохраняет одну\nпозицию в личном каталоге и сообщает результат."];
start -> s0;
s0 -> s1;
g1 [shape=diamond,style=filled,fillcolor="#EEF2F6",label="Есть совпадения?"];
e1 [label="Пустая выдача. Изменить или сбросить фильтры"];
s1 -> g1;
g1 -> s2 [label="Да"];
g1 -> e1 [label="Нет"];
e1 -> s1;
s2 -> s3;
g3 [shape=diamond,style=filled,fillcolor="#EEF2F6",label="Наценка допустима?"];
e3 [label="Исправить наценку"];
s3 -> g3;
g3 -> s4 [label="Да"];
g3 -> e3 [label="Нет"];
e3 -> s3;
s4 -> end;
}
