digraph Activity {
 graph [rankdir=TB,bgcolor="white",pad=0.3,nodesep=0.35,ranksep=0.45,label="UC-S02 · Обновить предложение и остаток" ,labelloc=t,fontname="Arial",fontsize=18];
 node [shape=box,style="rounded,filled",fillcolor="#F4F5F7",color="#CBD2D9",fontname="Arial",fontsize=12,margin="0.17,0.10"];
 edge [fontname="Arial",fontsize=10,color="#596774"];
 start [shape=circle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
 end [shape=doublecircle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
s0 [label="Открывает предложение Система показывает текущие\nусловия."];
s1 [label="Меняет цену, количество или доступность Система\nпоказывает изменения до подтверждения."];
s2 [label="Сохраняет Система подтверждает обновление\nпредложения."];
s3 [label="Дропшиппер открывает предложение Система\nпоказывает новую доступность и условия для нового\nзаказа."];
start -> s0;
s0 -> s1;
g1 [shape=diamond,style=filled,fillcolor="#EEF2F6",label="Значения допустимы?"];
e1 [label="Ошибка без сохранения"];
