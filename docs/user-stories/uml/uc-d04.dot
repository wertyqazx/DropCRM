digraph Activity {
 graph [rankdir=TB,bgcolor="white",pad=0.3,nodesep=0.35,ranksep=0.45,label="UC-D04 · Отследить исполнение заказа" ,labelloc=t,fontname="Arial",fontsize=18];
 node [shape=box,style="rounded,filled",fillcolor="#F4F5F7",color="#CBD2D9",fontname="Arial",fontsize=12,margin="0.17,0.10"];
 edge [fontname="Arial",fontsize=10,color="#596774"];
 start [shape=circle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
 end [shape=doublecircle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
s0 [label="Открывает список заказов Система показывает\nномер, поставщика, исполнение и оплату."];
s1 [label="Выбирает заказ Система показывает согласованный\nсостав, получателя и историю."];
s2 [label="Проверяет доставку При созданном отправлении\nвидит службу, трек и дату."];
s3 [label="Возвращается к списку Навигация сохраняет\nпонятный контекст заказа."];
start -> s0;
s0 -> s1;
s1 -> s2;
g2 [shape=diamond,style=filled,fillcolor="#EEF2F6",label="Отправление есть?"];
e2 [label="Ожидание без трек-номера"];
s2 -> g2;
g2 -> s3 [label="Да"];
g2 -> e2 [label="Нет"];
e2 -> end;
s3 -> end;
}
