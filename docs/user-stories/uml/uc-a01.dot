digraph Activity {
 graph [rankdir=TB,bgcolor="white",pad=0.3,nodesep=0.35,ranksep=0.45,label="UC-A01 · Рассмотреть заявку поставщика" ,labelloc=t,fontname="Arial",fontsize=18];
 node [shape=box,style="rounded,filled",fillcolor="#F4F5F7",color="#CBD2D9",fontname="Arial",fontsize=12,margin="0.17,0.10"];
 edge [fontname="Arial",fontsize=10,color="#596774"];
 start [shape=circle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
 end [shape=doublecircle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
s0 [label="Открывает очередь заявок Система показывает\nожидающую компанию."];
s1 [label="Открывает заявку Система показывает сведения и\nусловия работы."];
s2 [label="Проверяет сведения и одобряет подключение Система\nсохраняет решение."];
s3 [label="Поставщик продолжает работу Система предлагает\nподписку; само одобрение не открывает платный\nдоступ."];
start -> s0;
s0 -> s1;
g1 [shape=diamond,style=filled,fillcolor="#EEF2F6",label="Сведений достаточно?"];
e1 [label="Запросить уточнение с причиной"];
s1 -> g1;
g1 -> s2 [label="Да"];
g1 -> e1 [label="Нет"];
e1 -> end;
