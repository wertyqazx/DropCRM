digraph Activity {
 graph [rankdir=TB,bgcolor="white",pad=0.3,nodesep=0.35,ranksep=0.45,label="UC-D03 · Оформить и оплатить заказ" ,labelloc=t,fontname="Arial",fontsize=18];
 node [shape=box,style="rounded,filled",fillcolor="#F4F5F7",color="#CBD2D9",fontname="Arial",fontsize=12,margin="0.17,0.10"];
 edge [fontname="Arial",fontsize=10,color="#596774"];
 start [shape=circle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
 end [shape=doublecircle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
s0 [label="Выбирает позиции одного поставщика и количество\nСистема показывает предложение и доступное\nколичество."];
s1 [label="Указывает получателя и адрес Система проверяет\nобязательные сведения."];
s2 [label="Передаёт заказ поставщику Система показывает\nномер и ожидание подтверждения; доставка ещё не\nрассчитана."];
s3 [label="Поставщик подтверждает по UC-S03 Система\nпоказывает согласованные товары, доставку,\nкомиссию и итог."];
s4 [label="Дропшиппер подтверждает оплату Система показывает\nобработку платежа, затем его отдельный результат."];
s5 [label="Платёж успешен Заказ переходит в обработку,\nпоставщик видит возможность комплектации."];
start -> s0;
g0 [shape=diamond,style=filled,fillcolor="#EEF2F6",label="Наличие и один поставщик?"];
e0 [label="Исправить состав или количество"];
s0 -> g0;
g0 -> s1 [label="Да"];
g0 -> e0 [label="Нет"];
e0 -> s0;
g1 [shape=diamond,style=filled,fillcolor="#EEF2F6",label="Получатель заполнен?"];
e1 [label="Исправить данные получателя"];
s1 -> g1;
g1 -> s2 [label="Да"];
g1 -> e1 [label="Нет"];
e1 -> s1;
s2 -> s3;
g3 [shape=diamond,style=filled,fillcolor="#EEF2F6",label="Поставщик подтвердил?"];
e3 [label="Заказ отклонён с причиной. Оплаты нет"];
s3 -> g3;
g3 -> s4 [label="Да"];
g3 -> e3 [label="Нет"];
e3 -> end;
g4 [shape=diamond,style=filled,fillcolor="#EEF2F6",label="Платёж успешен?"];
e4 [label="Заказ не оплачен. Повтор к тому же заказу"];
s4 -> g4;
g4 -> s5 [label="Да"];
g4 -> e4 [label="Нет"];
e4 -> s4;
s5 -> end;
}
