digraph Activity {
 graph [rankdir=TB,bgcolor="white",pad=0.3,nodesep=0.35,ranksep=0.45,label="UC-A02 · Заблокировать и восстановить пользователя" ,labelloc=t,fontname="Arial",fontsize=18];
 node [shape=box,style="rounded,filled",fillcolor="#F4F5F7",color="#CBD2D9",fontname="Arial",fontsize=12,margin="0.17,0.10"];
 edge [fontname="Arial",fontsize=10,color="#596774"];
 start [shape=circle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
 end [shape=doublecircle,label="",width=.16,height=.16,fillcolor="#243647",color="#243647"];
s0 [label="Открывает пользователя Система показывает роль,\nсостояние доступа и подписку."];
s1 [label="Выбирает блокировку и указывает причину Система\nобъясняет последствия и запрашивает\nподтверждение."];
s2 [label="Подтверждает Система ограничивает новые действия,\nсохраняет историю и решение."];
s3 [label="При необходимости восстанавливает доступ Система\nпоказывает активный статус и сохраняет новое\nрешение."];
start -> s0;
s0 -> s1;
g1 [shape=diamond,style=filled,fillcolor="#EEF2F6",label="Подтверждено с причиной?"];
e1 [label="Оставить прежний доступ"];
s1 -> g1;
g1 -> s2 [label="Да"];
g1 -> e1 [label="Нет"];
e1 -> end;
s2 -> s3;
s3 -> end;
}
